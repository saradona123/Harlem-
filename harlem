                    </div>

                    <div class="flex justify-end pt-2">
                        <button id="quiz-next-btn" onclick="nextQuizQuestion()" class="hidden px-6 py-2.5 rounded-full bg-brown text-pure text-sm font-semibold hover:bg-crimson transition-colors">
                            Next Question →
                        </button>
                    </div>
                </div>

                <!-- Quiz Score Summary -->
                <div id="quiz-results-area" class="hidden text-center py-6 space-y-5">
                    <div class="w-16 h-16 rounded-full bg-gold-soft text-brown mx-auto flex items-center justify-center border-2 border-gold-bright">
                        <span id="quiz-score-fraction" class="editorial-title text-xl font-bold">5/5</span>
                    </div>
                    <div>
                        <h3 id="quiz-result-heading" class="editorial-title text-2xl font-bold text-brown">Remarkable Knowledge!</h3>
                        <p id="quiz-result-subtext" class="text-sm text-brown-light mt-2 max-w-md mx-auto">
                            You explored both the cultural breakthroughs and the intimate human stories behind the Harlem Renaissance.
                        </p>
                    </div>
                    <div class="flex flex-wrap justify-center gap-3 pt-2">
                        <button onclick="restartQuiz()" class="px-5 py-2.5 rounded-full bg-crimson text-pure text-sm font-semibold hover:bg-crimson-hover transition-colors">
                            Retake Quiz
                        </button>
                        <button onclick="switchTab('figures')" class="px-5 py-2.5 rounded-full bg-cream border border-brown-border text-brown text-sm font-semibold hover:bg-blush transition-colors">
                            Explore Figures Archive
                        </button>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- ========================================================= -->
    <!-- FIGURE DETAIL MODAL (HISTORY & PERSONAL LIFE)             -->
    <!-- ========================================================= -->
    <div id="figure-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-6 bg-brown/50 backdrop-blur-xs modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modal-figure-name">
        <div class="bg-pure w-full max-w-3xl max-h-[90vh] rounded-3xl border border-brown-border shadow-2xl flex flex-col overflow-hidden modal-panel">
            
            <!-- Modal Top Bar -->
            <div class="flex items-center justify-between px-6 py-4 bg-cream border-b border-brown-border shrink-0">
                <div class="flex items-center gap-2">
                    <span id="modal-category-badge" class="px-3 py-1 rounded-full bg-blush text-brown text-xs font-bold">
                        Category
                    </span>
                    <span id="modal-years-badge" class="text-xs font-medium text-brown-muted">
                        1900 – 1967
                    </span>
                </div>
                <button onclick="closeModal()" class="p-2 rounded-full text-brown hover:bg-blush transition-colors focus:outline-none" aria-label="Close modal">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <!-- Modal Scrollable Content -->
            <div class="p-6 sm:p-8 overflow-y-auto custom-scroll space-y-6">
                <!-- Header Identity -->
                <div class="flex flex-col sm:flex-row sm:items-center gap-5">
                    <div id="modal-monogram" class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-brown text-gold-bright flex items-center justify-center editorial-title text-2xl sm:text-3xl font-bold shrink-0 shadow-sm">
                        LH
                    </div>
                    <div>
                        <h2 id="modal-figure-name" class="editorial-title text-2xl sm:text-3xl font-bold text-brown">
                            Langston Hughes
                        </h2>
                        <p id="modal-figure-role" class="text-sm sm:text-base font-medium text-crimson mt-0.5">
                            Poet, Novelist, Playwright &amp; Columnist
                        </p>
                        <p id="modal-birthplace" class="text-xs text-brown-muted mt-1">
                            Born in Joplin, Missouri
                        </p>
                    </div>
                </div>

                <!-- Famous Quote Callout -->
                <blockquote class="p-4 sm:p-5 rounded-2xl bg-cream border-l-4 border-gold-bright">
                    <p id="modal-quote" class="editorial-title italic text-base sm:text-lg text-brown leading-relaxed">
                        "Hold fast to dreams, for if dreams die, life is a broken-winged bird that cannot fly."
                    </p>
                </blockquote>

                <!-- Dual Lens Switcher inside Modal -->
                <div class="flex border-b border-brown-border gap-6">
                    <button id="tab-btn-history" onclick="switchModalSubTab('history')" class="pb-3 text-sm font-bold border-b-2 border-crimson text-crimson transition-colors">
                        Historical Impact &amp; Legacy
                    </button>
                    <button id="tab-btn-personal" onclick="switchModalSubTab('personal')" class="pb-3 text-sm font-bold border-b-2 border-transparent text-brown-muted hover:text-brown transition-colors">
                        Personal Life &amp; Upbringing
                    </button>
                </div>

                <!-- Sub-Tab 1: Historical Impact -->
                <div id="modal-content-history" class="space-y-4 text-sm sm:text-base text-brown-light leading-relaxed">
                    <p id="modal-history-text"></p>
                    <div class="pt-2">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-brown mb-2">Landmark Works &amp; Contributions</h4>
                        <div id="modal-works-list" class="flex flex-wrap gap-2">
                            <!-- Work tags injected here -->
                        </div>
                    </div>
                </div>

                <!-- Sub-Tab 2: Personal Life -->
                <div id="modal-content-personal" class="hidden space-y-4 text-sm sm:text-base text-brown-light leading-relaxed">
                    <p id="modal-personal-text"></p>
                    <div class="p-4 rounded-xl bg-blush/40 border border-blush-medium/60">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-crimson mb-1">Intimate Detail &amp; Character</h4>
                        <p id="modal-personal-highlight" class="text-sm text-brown"></p>
                    </div>
                </div>
            </div>

            <!-- Modal Footer Navigation (Prev / Next Figure) -->
