                const card = document.createElement('article');
                card.className = 'figure-card bg-pure rounded-2xl border border-brown-border p-6 flex flex-col justify-between cursor-pointer group';
                card.onclick = () => openModal(idx);

                card.innerHTML = `
                    <div>
                        <div class="flex items-start justify-between gap-3 mb-4">
                            <div class="w-12 h-12 rounded-xl bg-cream border border-brown-border group-hover:bg-brown group-hover:text-gold-bright transition-colors flex items-center justify-center editorial-title text-lg font-bold text-brown">
                                ${fig.monogram}
                            </div>
                            <span class="px-2.5 py-1 rounded-full bg-blush/70 text-brown text-xs font-semibold">
                                ${fig.category}
                            </span>
                        </div>

                        <h3 class="editorial-title text-xl font-bold text-brown group-hover:text-crimson transition-colors">
                            ${fig.name}
                        </h3>
                        <p class="text-xs font-semibold text-crimson mt-0.5 mb-3">
                            ${fig.role} • <span class="text-brown-muted font-normal">${fig.years}</span>
                        </p>

                        <p class="text-sm text-brown-light leading-relaxed line-clamp-3">
                            ${fig.summary}
                        </p>
                    </div>

                    <div class="mt-6 pt-4 border-t border-brown-border/70 flex items-center justify-between text-xs font-semibold">
                        <span class="text-brown-muted">History &amp; Personal Life</span>
                        <span class="text-crimson group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                            Read Profile <span>→</span>
                        </span>
                    </div>
                `;

                grid.appendChild(card);
            });
        }

        // Open Figure Detail Modal
        function openModal(filteredIndex) {
            activeModalIndex = filteredIndex;
            populateModalContent(currentFilteredFigures[activeModalIndex]);
            switchModalSubTab('history');

            const modal = document.getElementById('figure-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        }

        // Close Modal
        function closeModal() {
            const modal = document.getElementById('figure-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        }

        // Navigate Previous / Next inside Modal
        function navigateModal(direction) {
            const total = currentFilteredFigures.length;
            activeModalIndex = (activeModalIndex + direction + total) % total;
            populateModalContent(currentFilteredFigures[activeModalIndex]);
        }

        // Populate Modal Fields
        function populateModalContent(fig) {
            document.getElementById('modal-category-badge').textContent = fig.category;
            document.getElementById('modal-years-badge').textContent = fig.years;
            document.getElementById('modal-monogram').textContent = fig.monogram;
            document.getElementById('modal-figure-name').textContent = fig.name;
            document.getElementById('modal-figure-role').textContent = fig.role;
            document.getElementById('modal-birthplace').textContent = `Origin: ${fig.birthplace}`;
            document.getElementById('modal-quote').textContent = fig.quote;

            // History Tab Content
            document.getElementById('modal-history-text').textContent = fig.history;
            const worksContainer = document.getElementById('modal-works-list');
            worksContainer.innerHTML = '';
            fig.works.forEach(work => {
                const badge = document.createElement('span');
                badge.className = 'px-3 py-1 rounded-full bg-gold-soft/80 border border-gold-bright/50 text-brown text-xs font-semibold';
                badge.textContent = work;
                worksContainer.appendChild(badge);
            });

            // Personal Life Tab Content
            document.getElementById('modal-personal-text').textContent = fig.personal;
            document.getElementById('modal-personal-highlight').textContent = fig.personalHighlight;

            // Counter
            document.getElementById('modal-index-indicator').textContent = `${activeModalIndex + 1} of ${currentFilteredFigures.length}`;
        }

        // Switch between Historical Impact & Personal Life inside Modal
        function switchModalSubTab(subTab) {
            const btnHistory = document.getElementById('tab-btn-history');
            const btnPersonal = document.getElementById('tab-btn-personal');
            const contentHistory = document.getElementById('modal-content-history');
            const contentPersonal = document.getElementById('modal-content-personal');

            if (subTab === 'history') {
                btnHistory.classList.add('border-crimson', 'text-crimson');
                btnHistory.classList.remove('border-transparent', 'text-brown-muted');
                btnPersonal.classList.remove('border-crimson', 'text-crimson');
                btnPersonal.classList.add('border-transparent', 'text-brown-muted');

                contentHistory.classList.remove('hidden');
                contentPersonal.classList.add('hidden');
            } else {
                btnPersonal.classList.add('border-crimson', 'text-crimson');
                btnPersonal.classList.remove('border-transparent', 'text-brown-muted');
                btnHistory.classList.remove('border-crimson', 'text-crimson');
                btnHistory.classList.add('border-transparent', 'text-brown-muted');

                contentPersonal.classList.remove('hidden');
                contentHistory.classList.add('hidden');
            }
        }

        // =========================================================
        // INTERACTIVE QUIZ LOGIC
        // =========================================================
        function loadQuizQuestion() {
            quizAnswered = false;
            const qData = quizQuestions[currentQuizIndex];

            document.getElementById('quiz-progress-badge').textContent = `Question ${currentQuizIndex + 1} of ${quizQuestions.length}`;
            document.getElementById('quiz-question-text').textContent = qData.question;
            document.getElementById('quiz-feedback-box').classList.add('hidden');
            document.getElementById('quiz-next-btn').classList.add('hidden');

            const optionsContainer = document.getElementById('quiz-options-container');
            optionsContainer.innerHTML = '';

            qData.options.forEach((optionText, index) => {
                const btn = document.createElement('button');
                btn.className = 'quiz-opt-btn w-full text-left p-4 rounded-xl border border-brown-border bg-cream hover:bg-blush/50 text-sm sm:text-base font-medium text-brown transition-all flex items-center justify-between gap-3';
                btn.innerHTML = `
                    <span>${optionText}</span>
                    <span class="opt-status text-xs font-bold"></span>
                `;
                btn.onclick = () => selectQuizAnswer(index, btn);
                optionsContainer.appendChild(btn);
            });
        }

        function selectQuizAnswer(selectedIndex, clickedBtn) {
            if (quizAnswered) return;
            quizAnswered = true;

            const qData = quizQuestions[currentQuizIndex];
            const allBtns = document.querySelectorAll('.quiz-opt-btn');

            allBtns.forEach((btn, idx) => {
                btn.disabled = true;
                btn.classList.remove('hover:bg-blush/50');
                const statusEl = btn.querySelector('.opt-status');

                if (idx === qData.correctIndex) {
                    btn.classList.remove('bg-cream', 'border-brown-border');
                    btn.classList.add('bg-gold-soft', 'border-gold-bright', 'font-bold');
                    statusEl.textContent = '✓ Correct';
                    statusEl.classList.add('text-brown');
                } else if (idx === selectedIndex && selectedIndex !== qData.correctIndex) {
                    btn.classList.remove('bg-cream', 'border-brown-border');
                    btn.classList.add('bg-crimson-soft', 'border-crimson');
                    statusEl.textContent = '✕ Incorrect';
                    statusEl.classList.add('text-crimson');
                }
            });

            if (selectedIndex === qData.correctIndex) {
                quizScore++;
            }

            const feedbackBox = document.getElementById('quiz-feedback-box');
            feedbackBox.innerHTML = `<strong class="text-brown">Context:</strong> ${qData.explanation}`;
            feedbackBox.classList.remove('hidden');

            const nextBtn = document.getElementById('quiz-next-btn');
            nextBtn.textContent = currentQuizIndex === quizQuestions.length - 1 ? 'See Final Score →' : 'Next Question →';
            nextBtn.classList.remove('hidden');
        }

        function nextQuizQuestion() {
            currentQuizIndex++;
            if (currentQuizIndex < quizQuestions.length) {
                loadQuizQuestion();
            } else {
                showQuizResults();
            }
        }

        function showQuizResults() {
            document.getElementById('quiz-active-area').classList.add('hidden');
            document.getElementById('quiz-results-area').classList.remove('hidden');
            document.getElementById('quiz-progress-badge').textContent = 'Completed';
            document.getElementById('quiz-score-fraction').textContent = `${quizScore}/${quizQuestions.length}`;

            const heading = document.getElementById('quiz-result-heading');
            const subtext = document.getElementById('quiz-result-subtext');

            if (quizScore === quizQuestions.length) {
                heading.textContent = 'Harlem Renaissance Scholar!';
                subtext.textContent = 'A perfect score! You mastered both the artistic milestones and intimate personal histories of the era.';
            } else if (quizScore >= 3) {
                heading.textContent = 'Great Work!';
                subtext.textContent = 'You have a strong grasp of the figures who shaped the New Negro Movement. Explore any remaining profiles in the archive!';
            } else {
                heading.textContent = 'Keep Exploring!';
                subtext.textContent = 'Browse the Notable Figures cards to uncover more behind-the-scenes details about their lives and works.';
            }
        }

        function restartQuiz() {
            currentQuizIndex = 0;
            quizScore = 0;
            document.getElementById('quiz-results-area').classList.add('hidden');
            document.getElementById('quiz-active-area').classList.remove('hidden');
            loadQuizQuestion();
        }
    </script>
</body>
</html>
